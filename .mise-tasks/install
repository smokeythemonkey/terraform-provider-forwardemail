#!/usr/bin/env bash
#MISE description="Set up overrides allowing a local version of the provider to be used by Terraform and OpenTofu"
set -euo pipefail

BIN_DIR=$(go env GOBIN)
[ -n "$BIN_DIR" ] || BIN_DIR=$(go env GOPATH)/bin
for RC in "$HOME/.terraformrc" "$HOME/.tofurc"; do
cat <<EOF > "$RC"
provider_installation {
  dev_overrides {
    "smokeythemonkey/forwardemail" = "$BIN_DIR"
  }
  direct {}
}
EOF
done
go install .
